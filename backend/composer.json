{
    "name": "webhatchery/quiet-recall-backend",
    "description": "Quiet Recall authoritative PHP backend",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "firebase/php-jwt": "^6.11 || ^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0
    },
    "scripts": {
        "start": "php -S localhost:8000 public/index.php",
        "db:init": "php bin/db-init.php",
        "test": "..\\..\\..\\vendor\\bin\\phpunit -c phpunit.xml",
        "cs-check": "..\\..\\..\\vendor\\bin\\phpcs --standard=PSR12 src public bin tests",
        "cs-fix": "..\\..\\..\\vendor\\bin\\phpcbf --standard=PSR12 src public bin tests"
    }
}
